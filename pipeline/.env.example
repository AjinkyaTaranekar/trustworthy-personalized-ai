# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit the real file.

# ── Anthropic (critic model in gold response generator) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── NVIDIA NIM (teacher models: Kimi K2.6, Minimax M2.7 — free tier available)
# NVIDIA_NIM_API_KEY=nvapi-...
# Usage: --model nvidia_nim/moonshotai/kimi-k2.6
#        --model nvidia_nim/minimaxai/minimax-m2.7
# API base auto-set to https://integrate.api.nvidia.com/v1

# ── HuggingFace (needed for downloading Qwen3-0.6B base model) ───────────────
# HF_TOKEN=hf_...

# ── OpenAI (optional alternative teacher/critic) ──────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Groq (optional, fast + free tier) ────────────────────────────────────────
# GROQ_API_KEY=gsk_...

# ── Ollama (local — no key needed, just set the base URL) ────────────────────
# OLLAMA_API_BASE=http://localhost:11434

# ── FalkorDB (only needed if PIPELINE_ENABLE_USER_MODELLING=true) ────────────
# Local Docker:   HOST=localhost, PORT=6379, USER and PASSWORD empty.
# FalkorDB Cloud: HOST=<instance>.cloud, PORT=<port>, USER and PASSWORD from the dashboard.
#   Example cloud endpoint: r-6jissuruar.instance-tzp39ltng.hc-srom4rolb.eu-west-1.aws.f2e0a955bb84.cloud:62418
PIPELINE_FALKORDB_HOST=localhost
PIPELINE_FALKORDB_PORT=6379
PIPELINE_FALKORDB_USER=
PIPELINE_FALKORDB_PASSWORD=
PIPELINE_FALKORDB_GRAPH_NAME=user_model

# ── Feature flags (all default to false) ─────────────────────────────────────
PIPELINE_ENABLE_USER_MODELLING=false
PIPELINE_ENABLE_EMPATHY=false
PIPELINE_ENABLE_GRPO=false
PIPELINE_ENABLE_PERSONALISATION=false
PIPELINE_ENABLE_ONTOLOGY_VERIF=false
