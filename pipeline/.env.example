# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit the real file.

# ── Anthropic (default for V2 pipeline) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (optional alternative) ────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Groq (optional, fast + free tier) ────────────────────────────────────────
# GROQ_API_KEY=gsk_...

# ── Ollama (local — no key needed, just set the base URL) ────────────────────
# OLLAMA_API_BASE=http://localhost:11434

# ── NVIDIA NIM (frontier models: Kimi K2.6, Minimax M2.7 — free tier available)
# NVIDIA_NIM_API_KEY=nvapi-...
# Usage: --model nvidia_nim/moonshotai/kimi-k2.6
#        --model nvidia_nim/minimaxai/minimax-m2.7
# API base auto-set to https://integrate.api.nvidia.com/v1

# ── HuggingFace (needed for downloading Qwen3-0.6B base model) ───────────────
# HF_TOKEN=hf_...
