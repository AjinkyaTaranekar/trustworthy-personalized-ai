# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit the real file.

# ── Anthropic (default for V2 pipeline) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (optional alternative) ────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Groq (optional, fast + free tier) ────────────────────────────────────────
# GROQ_API_KEY=gsk_...

# ── Ollama (local — no key needed, just set the base URL) ────────────────────
# OLLAMA_API_BASE=http://localhost:11434

# ── HuggingFace (needed for downloading Qwen3-0.6B base model) ───────────────
# HF_TOKEN=hf_...
